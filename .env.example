# Amalthea — local development environment. Copy to .env and fill in.
# NEVER commit a real .env. Every value here is a non-secret placeholder.

DJANGO_SETTINGS_MODULE=amalthea.settings.dev
DJANGO_SECRET_KEY=dev-only-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -----------------------------------------------------------
# dev defaults to SQLite so `manage.py` works with no external services.
DATABASE_URL=sqlite:///amalthea.sqlite3
# Postgres 15+ (JSONB, GIN, partial indexes). CI and prod MUST use this.
# DATABASE_URL=postgres://amalthea:amalthea@localhost:5432/amalthea

# --- Redis (Celery broker + Channels channel layer) ---------------------
REDIS_URL=redis://localhost:6379/0

# --- Celery -------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Ingestion ----------------------------------------------------------
# Cap on webhook body size, enforced BEFORE JSON parse (bytes).
AMALTHEA_MAX_WEBHOOK_BYTES=1048576
# Per-source and per-IP webhook rate limits, per minute.
AMALTHEA_WEBHOOK_RATE_SOURCE=60
AMALTHEA_WEBHOOK_RATE_IP=300

# --- Security -----------------------------------------------------------
# Argon2 params for API keys (kept modest here; raise in prod).
AMALTHEA_APIKEY_HASH_ITERATIONS=600000
AMALTHEA_CSP=default-src 'self'
