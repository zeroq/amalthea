# Amalthea — local development environment. Copy to .env and fill in.
# NEVER commit a real .env. Every value here is a non-secret placeholder.

DJANGO_SETTINGS_MODULE=amalthea.settings.dev
DJANGO_SECRET_KEY=dev-only-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -----------------------------------------------------------
# dev defaults to SQLite so `manage.py` works with no external services.
DATABASE_URL=sqlite:///amalthea.sqlite3
# Postgres 15+ (JSONB, GIN, partial indexes). CI and prod MUST use this.
# DATABASE_URL=postgres://amalthea:amalthea@localhost:5432/amalthea

# --- Redis (Celery broker + Channels channel layer) ---------------------
REDIS_URL=redis://localhost:6379/0

# --- Celery -------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Ingestion ----------------------------------------------------------
# Cap on webhook body size, enforced BEFORE JSON parse (bytes).
AMALTHEA_MAX_WEBHOOK_BYTES=1048576
# Per-source and per-IP webhook rate limits, per minute.
AMALTHEA_WEBHOOK_RATE_SOURCE=60
AMALTHEA_WEBHOOK_RATE_IP=300
# Separate pre-auth per-IP budget. Checked before token lookup; must be > 0 in production.
AMALTHEA_WEBHOOK_PREAUTH_IP=600

# --- Security -----------------------------------------------------------
# Argon2 params for API keys (kept modest here; raise in prod).
AMALTHEA_APIKEY_HASH_ITERATIONS=600000

# --- MCP server (Phase 1) -----------------------------------------------
#: Enable the MCP /mcp/ endpoint (default false). Disabled = clean 404.
AMALTHEA_MCP_ENABLED=false
#: Base URL for the MCP server, advertised in protected-resource metadata.
AMALTHEA_MCP_BASE_URL=
#: Max rows any MCP read tool may return.
AMALTHEA_MCP_MAX_ROWS=50
#: Hard timeout (seconds) for any MCP tool execution.
AMALTHEA_MCP_TIMEOUT_SECONDS=15
#: Per-credential and per-IP request budget, fixed one-minute window.
AMALTHEA_MCP_RATE_PER_MINUTE=60
#: Exact number of trusted reverse proxies in front of Daphne.  0 uses the direct
#: peer and ignores X-Forwarded-For; set only when proxies are known and append the header.
AMALTHEA_MCP_TRUSTED_PROXY_COUNT=0
#: Max request body size (bytes) for MCP POST requests.
AMALTHEA_MCP_MAX_BODY_BYTES=4194304
#: Comma-separated allowed origins for Cross-origin MCP requests.
AMALTHEA_MCP_ALLOWED_ORIGINS=
#: Hosts allowed to connect to the MCP endpoint; falls back to DJANGO_ALLOWED_HOSTS.
AMALTHEA_MCP_ALLOWED_HOSTS=

# --- MCP server (Phase 3) OAuth -------------------------------------------
#: Authentication mode: static (default), oauth, or both. In oauth mode, only OAuth
#: access tokens issued by the configured IdP are accepted. In static mode, only
#: static bearer credentials are accepted. In both mode, both are accepted (legacy use
#: is audited).
AMALTHEA_MCP_AUTH_MODE=static
#: Exact expected iss (issuer) value. Must match the JWT `iss` claim.
#: HTTPS URL in production; e.g. https://idp.example.com.
AMALTHEA_MCP_OAUTH_ISSUER=
#: HTTPS JWKS URI serving the RSA public keys for JWT signature verification.
#: Exact allowlisted URL; no redirects followed. e.g. https://idp.example.com/.well-known/jwks.json
AMALTHEA_MCP_OAUTH_JWKS_URL=
#: Comma-separated list of allowed JWT algorithms for access token signature verification.
#: Default RS256; symmetric algorithms (HS*) and 'none' are rejected in production.
#: e.g. RS256
AMALTHEA_MCP_OAUTH_JWT_ALGS=RS256
#: JWKS cache TTL in seconds. Minimum 300, default 3600. In production, use Redis-backed
#: cache for shared JWKS across workers.
AMALTHEA_MCP_OAUTH_JWKS_CACHE_SECONDS=3600
#: Clock skew tolerance in seconds. Maximum 60, default 30. Tolerates small time
#: differences between the IdP and the Amalthea server.
AMALTHEA_MCP_OAUTH_CLOCK_SKEW_SECONDS=30

# --- Attachments --------------------------------------------------------
# Hard ceiling for one case attachment, checked before it is written to storage (bytes).
AMALTHEA_MAX_ATTACHMENT_BYTES=26214400
# Prefix under MEDIA_ROOT where opaque attachment blobs are stored.
AMALTHEA_ATTACHMENT_PREFIX=attachments
